{
  "name": "@lggarrison/landlord",
  "version": "0.1.0",
  "description": "Monte Carlo MTG on-curve simulator (TypeScript port of landlord)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "card-update": "tsx scripts/card-update.ts",
    "wiki:help": "llm-wiki-manager help",
    "wiki:lint": "llm-wiki-manager lint",
    "wiki:build": "llm-wiki-manager build",
    "wiki:check": "llm-wiki-manager check",
    "wiki:sync": "llm-wiki-manager sync",
    "wiki:log": "llm-wiki-manager log",
    "wiki:doctor": "llm-wiki-manager doctor",
    "wiki:setup:husky": "llm-wiki-manager setup-husky",
    "prepare": "husky"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "husky": "^9.1.7",
    "llm-wiki-manager": "^1.0.3",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
